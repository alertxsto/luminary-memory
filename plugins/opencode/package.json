{
  "name": "luminary-memory-opencode",
  "version": "0.3.3",
  "description": "Luminary-maintained scoped memory plugin for OpenCode V2",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./rpc": "./dist/rpc.js",
    "./tui": "./dist/tui.js",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": ["dist/", "README.md", "LICENSE"],
  "engines": {"node": "^22.22.2 || ^24.15.0 || >=26.0.0"},
  "license": "Apache-2.0",
  "author": "Dwiky Candra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alertxsto/luminary-memory.git",
    "directory": "plugins/opencode"
  },
  "homepage": "https://github.com/alertxsto/luminary-memory#readme",
  "bugs": {"url": "https://github.com/alertxsto/luminary-memory/issues"},
  "keywords": ["opencode", "opencode-plugin", "luminary", "memory"],
  "publishConfig": {"access": "public"},
  "scripts": {"prepack": "node ../../scripts/build-plugins.mjs"},
  "dependencies": {
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.2.0",
    "effect": "4.0.1",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "solid-js": ">=1.9.12"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {"optional": true},
    "effect": {"optional": true},
    "@opentui/core": {"optional": true},
    "@opentui/solid": {"optional": true},
    "solid-js": {"optional": true}
  }
}
